{
  "name": "@larkup/sandbox",
  "version": "0.1.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./docker-runner": {
      "types": "./dist/docker-runner.d.ts",
      "import": "./dist/docker-runner.js",
      "default": "./dist/docker-runner.js"
    },
    "./sandbox-manager": {
      "types": "./dist/sandbox-manager.d.ts",
      "import": "./dist/sandbox-manager.js",
      "default": "./dist/sandbox-manager.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --outDir dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dockerode": "^5.0.1"
  },
  "optionalDependencies": {
    "e2b": "^2.39.0",
    "@vercel/sandbox": "^3.0.0",
    "modal": "^0.10.0",
    "@daytona/sdk": "^0.207.0",
    "@browserbasehq/sdk": "^2.17.0",
    "playwright-core": "^1.62.1",
    "@fly/sprites": "^0.2.0",
    "@northflank/js-client": "^0.10.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
