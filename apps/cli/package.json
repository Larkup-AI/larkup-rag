{
  "name": "@larkup/cli",
  "version": "0.2.32",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "larkup": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "larkup": "tsx src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^4.0.37",
    "@ai-sdk/deepseek": "^3.0.39",
    "@ai-sdk/gateway": "^4.0.73",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/mistral": "^4.0.39",
    "@ai-sdk/openai": "^4.0.57",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@clack/prompts": "^1.7.0",
    "@lancedb/lancedb": "^0.38.0",
    "@larkup/core": "workspace:*",
    "@larkup/marketplace": "workspace:*",
    "@larkup/vector-stores": "workspace:*",
    "@pinecone-database/pinecone": "^8.1.0",
    "ai": "^7.0.91",
    "apache-arrow": "18.1.0",
    "chalk": "^6.0.0",
    "chromadb": "^3.5.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
